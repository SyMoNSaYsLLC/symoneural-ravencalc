# RavenCalc (server-side secrets)
#
# Copy this file to .env and fill in RAVENCALC_API_KEY. The value here is
# deliberately EMPTY: this file is committed, so anything written in it is
# published. run.sh refuses to start until a real key is set. Generate one:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The key guards /api/compute and /api/ask only. The browser UI talks to the
# same-origin /ui/* routes and never sends it.
RAVENCALC_API_KEY=
RAVENCALC_MAX_EXPR_LEN=4000
RAVENCALC_RATE_PER_MIN=60

# Public hostname (used only for links)
RAVENCALC_PUBLIC_HOST=https://www.symoneural.com

# --- Natural-language layer (optional) --------------------------------------
# Uncomment RAVENCALC_NO_AI to run standalone: SymPy math works and /ui/ask and
# /api/ask say plainly that the AI layer is off. See "Standalone mode" in the
# README. Left commented, the LLM front end is on.
#RAVENCALC_NO_AI=1
#RAVENCALC_LLM_URL=http://localhost:9001
#RAVENCALC_LLM_MODEL=symon
# The engine's bearer key. Falls back to VLLM_API_KEY from the environment,
# which a non-login shell does not export -- set it here if /ui/ask reports
# that the key was rejected.
#RAVENCALC_LLM_API_KEY=
