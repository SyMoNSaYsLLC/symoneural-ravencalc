# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Cloudflare / secrets
# .env holds the real RAVENCALC_API_KEY; .env.example is committed and must
# stay blank. Credentials are matched by name rather than with a blanket
# *.json, which silently untracked every config file and test fixture here.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Editor / OS
.vscode/
.DS_Store
